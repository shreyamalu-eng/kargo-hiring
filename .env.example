# Neon Postgres. `neon deploy` pulls this into .env automatically; or copy it from Neon Console -> Connect.
# Server-only. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# Google AI Studio -> API keys. Use a billing-enabled key for real CVs (free tier inputs may be used to improve Google models).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Resend (leave blank until checkpoint B-2)
RESEND_API_KEY=
# onboarding@resend.dev works without a verified domain, but only delivers to the address your Resend account was created with.
RESEND_FROM=Arjun Mehta <onboarding@resend.dev>
# Test mode: send every email to this address (with the candidate's address in the subject).
# Needed while using onboarding@resend.dev, which only delivers to your own Resend account address.
EMAIL_TEST_RECIPIENT=
# Safety net: refuse to send to any address outside this domain (comma-separated). Leave set during the course.
EMAIL_ALLOWED_DOMAINS=pg27.mesaschool.co


